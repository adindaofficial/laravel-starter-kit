{
    "name": "mwy/laravel-starter-kit",
    "description": "Laravel Tailwind starter kit package with layouts, users page, DataTables, icons, SweetAlert, and seeders.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mwy\\LaravelStarterKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mwy\\LaravelStarterKit\\LaravelStarterKitServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
